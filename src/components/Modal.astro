---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import founders from "../assets/tools/founders";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const MODAL_ID = "founder-modal";

const founderImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/Founders/*.png",
  { eager: true },
);

function getImage(filename: string): string {
  const key = Object.keys(founderImages).find((k) =>
    k.toLowerCase().endsWith("/" + filename.toLowerCase()),
  );
  return key ? (founderImages[key]?.default?.src ?? "") : "";
}

const founderData = founders.map((f) => ({
  id: f.id,
  name: f.name,
  imageSrc: getImage(f.image),
  director: t(f.director as any),
  descriptions: f.descriptionKeys.map((k) => t(k as any)),
}));
---

<div
  id={MODAL_ID}
  tabindex="-1"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="founder-modal-name"
  class="hidden fixed inset-0 w-full overflow-y-auto bg-black/60 backdrop-blur-sm"
  style="z-index: 9999;"
>
  <!-- Centering wrapper — klik di sini (di luar card) akan menutup modal -->
  <div
    id="founder-modal-overlay"
    class="flex min-h-full items-center justify-center p-4"
  >
    <!-- Dialog card — stopPropagation di JS agar klik dalam card tidak menutup -->
    <div
      id="founder-modal-content"
      class="relative w-full max-w-6xl bg-white rounded-2xl shadow-2xl overflow-y-auto max-h-[90vh]"
    >
      <!-- Tombol tutup -->
      <button
        id="founder-close-btn"
        type="button"
        aria-label="Tutup"
        class="absolute top-4 right-4 z-10 flex items-center justify-center w-9 h-9 rounded-full
               border-2 border-red-600 text-red-600
               hover:bg-red-600 hover:text-white
               transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-400"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
      <div class="flex flex-col md:grid md:grid-cols-[500px_1fr] gap-6">
        <!-- Kiri / Atas: foto + identitas -->
        <div
          class="flex flex-col items-center justify-center gap-5
                    bg-linear-to-b from-gray-50 to-gray-100
                    px-8 pt-12 pb-8 md:rounded-l-2xl"
        >
          <div class="relative">
            <div
              class="w-44 h-56 sm:w-82.5 sm:h-auto rounded-2xl overflow-hidden"
            >
              <img
                id="founder-modal-image"
                src=""
                alt=""
                class="w-full h-full object-cover object-top"
              />
            </div>
          </div>

          <div class="text-center mt-2">
            <h2
              id="founder-modal-name"
              class="text-xl font-bold text-gray-900 leading-snug"
            >
            </h2>
            <p
              id="founder-modal-director"
              class="text-sm text-red-600 font-semibold mt-1"
            >
            </p>
          </div>
        </div>

        <!-- Kanan / Bawah: deskripsi scrollable -->
        <div class="flex flex-col justify-center px-8 py-8 md:py-10">
          <div class="flex items-center gap-2 mb-5">
            <div class="w-8 h-1 bg-red-600 rounded-full"></div>
            <div class="w-3 h-1 bg-red-200 rounded-full"></div>
          </div>

          <div
            id="founder-modal-description"
            class="space-y-4 text-sm md:text-base text-gray-500 leading-relaxed"
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* ── Modal wrapper: backdrop + fade ── */
  #founder-modal {
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  #founder-modal.is-open {
    opacity: 1;
  }

  /* ── Dialog card: slide-up + spring scale ── */
  #founder-modal-content {
    opacity: 0;
    transform: translateY(24px) scale(0.97);
    transition:
      opacity 0.25s ease,
      transform 0.35s cubic-bezier(0.34, 1.45, 0.64, 1);
  }
  #founder-modal.is-open #founder-modal-content {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
</style>

<script define:vars={{ founderData, MODAL_ID }}>
  const $modal = () => document.getElementById(MODAL_ID);
  const $content = () => document.getElementById("founder-modal-content");

  /* ── Isi konten modal ── */
  function fillModal(founder) {
    const img = document.getElementById("founder-modal-image");
    if (img) {
      img.src = founder.imageSrc;
      img.alt = founder.name;
    }

    const setText = (id, val) => {
      const el = document.getElementById(id);
      if (el) el.textContent = val;
    };
    setText("founder-modal-name", founder.name);
    setText("founder-modal-director", founder.director);

    const desc = document.getElementById("founder-modal-description");
    if (desc) {
      desc.innerHTML = founder.descriptions.map((p) => `<p>${p}</p>`).join("");
    }
  }

  /* ── Buka modal ── */
  function openModal() {
    const m = $modal();
    if (!m) return;

    m.classList.remove("hidden");
    m.offsetHeight; // force reflow → aktifkan CSS transition
    m.classList.add("is-open");
    m.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }

  /* ── Tutup modal ── */
  function closeModal() {
    const m = $modal();
    if (!m) return;

    m.classList.remove("is-open");
    m.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";

    m.addEventListener(
      "transitionend",
      () => {
        m.classList.add("hidden");
      },
      { once: true },
    );
  }

  /* ── Init event listeners ── */
  let initialized = false;

  function init() {
    if (initialized) return;
    initialized = true;

    window.__openFounderModal = (id) => {
      const f = founderData.find((x) => x.id === id);
      if (f) {
        fillModal(f);
        openModal();
      }
    };

    document.addEventListener("click", (e) => {
      const m = $modal();
      if (!m || !m.classList.contains("is-open")) return;

      // Buka — tombol dengan data-founder-id
      const trigger = e.target.closest("[data-founder-id]");
      if (trigger) {
        const id = trigger.getAttribute("data-founder-id");
        const f = founderData.find((x) => x.id === id);
        if (f) {
          fillModal(f);
          openModal();
        }
        return;
      }

      // Tutup — tombol ✕
      if (e.target.closest("#founder-close-btn")) {
        closeModal();
        return;
      }

      // ✅ Tutup — klik di luar dialog card (area overlay/backdrop)
      // Jika klik TIDAK mengenai #founder-modal-content atau child-nya → tutup
      const content = $content();
      if (content && !content.contains(e.target)) {
        closeModal();
      }
    });

    // Buka — tombol trigger (di luar modal, tidak butuh modal is-open)
    document.addEventListener("click", (e) => {
      const trigger = e.target.closest("[data-founder-id]");
      if (!trigger) return;
      const m = $modal();
      if (m && m.classList.contains("is-open")) return; // sudah ditangani atas
      const id = trigger.getAttribute("data-founder-id");
      const f = founderData.find((x) => x.id === id);
      if (f) {
        fillModal(f);
        openModal();
      }
    });

    // Tutup — Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && $modal()?.classList.contains("is-open")) {
        closeModal();
      }
    });
  }

  init();

  document.addEventListener("astro:after-swap", () => {
    initialized = false;
    init();
  });
</script>

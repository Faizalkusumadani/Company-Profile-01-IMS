---

<div id="ims-page-loader" aria-hidden="true">
  <div class="loader-inner">
    <div class="loader-logo">
      <img
        src="/ims-touch-icon.png"
        alt="IMS Logo"
        width="120"
        height="80"
        style="object-fit: contain;"
      />
      <span class="loader-brand">Intisukses Mitra Sejati</span>
    </div>
    <div class="loader-bar-wrap">
      <div class="loader-bar" id="ims-loader-bar"></div>
    </div>
    <p class="loader-label" id="ims-loader-label">Memuat...</p>
  </div>
</div>

<style>
  /* Default: tersembunyi. Script yang mengaktifkan jika perlu. */
  #ims-page-loader {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: #ffffff;
    display: none;
    align-items: center;
    justify-content: center;
  }

  #ims-page-loader.is-active {
    display: flex;
  }

  #ims-page-loader.fade-out {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .loader-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    width: 260px;
  }

  .loader-logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .loader-brand {
    font-size: 16px;
    font-weight: 700;
    color: #111827;
    letter-spacing: 0.03em;
  }

  .loader-bar-wrap {
    width: 100%;
    height: 4px;
    background: #f0f0f0;
    border-radius: 999px;
    overflow: hidden;
  }

  .loader-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #cc0000, #ff4444);
    border-radius: 999px;
    transition: width 0.4s ease;
  }

  .loader-label {
    font-size: 12px;
    color: #9ca3af;
    margin: 0;
    font-family: sans-serif;
  }
</style>

<script is:inline>
  (function () {
    var KEY = "ims_shown";

    // Sudah pernah tampil → tidak perlu lagi
    if (sessionStorage.getItem(KEY)) return;
    sessionStorage.setItem(KEY, "1");

    var loader = document.getElementById("ims-page-loader");
    var bar = document.getElementById("ims-loader-bar");
    var label = document.getElementById("ims-loader-label");

    if (!loader) return;

    var done = false;

    function setProgress(pct, txt) {
      if (bar) bar.style.width = pct + "%";
      if (label) label.textContent = txt;
    }

    function hide() {
      if (done) return;
      done = true;
      setProgress(100, "Selamat datang!");
      setTimeout(function () {
        loader.classList.add("fade-out");
        document.body.style.overflow = "";
        setTimeout(function () {
          loader.style.display = "none";
        }, 550);
      }, 300);
    }

    // Tampilkan & kunci scroll
    loader.classList.add("is-active");
    document.body.style.overflow = "hidden";

    // Jalankan progress bar
    setProgress(15, "Memuat aset...");
    setTimeout(function () {
      setProgress(45, "Menyiapkan konten...");
    }, 350);
    setTimeout(function () {
      setProgress(78, "Hampir selesai...");
    }, 800);

    document.addEventListener("astro:page-load", hide, { once: true });

    // ✅ Fallback anti-stuck: 6 detik
    setTimeout(hide, 6000);
  })();
</script>

---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import PageLoader from "../components/Pageloader.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { pwaInfo } from "virtual:pwa-info";
import JsonLd from "../components/JsonLd.astro";
import { organizationSchema } from "../assets/tools/schema";

interface Props {
  title: string;
  description: string;
  image?: string;
  url?: string;
  schema?: Record<string, any> | Record<string, any>[];
}

const SITE_URL = "https://intisukses-ms.com";

const {
  title,
  description,
  image = `${SITE_URL}/og-default.png`,
  url = Astro.url.href,
  schema,
} = Astro.props;

const ogImage = image.startsWith("http") ? image : `${SITE_URL}${image}`;
const ogTitle = `Intisukses Mitra Sejati | ${title}`;

// Organization schema selalu tampil + schema tambahan per-halaman (kalau ada)
const jsonLdData = schema
  ? [organizationSchema, ...(Array.isArray(schema) ? schema : [schema])]
  : organizationSchema;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Intisukses Mitra Sejati | {title}</title>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Intisukses Mitra Sejati" />
    <meta name="robots" content="index, follow" />

    <!-- ─── Open Graph ────────────────────────────────────────────────────── -->
    <meta property="og:site_name" content="Intisukses Mitra Sejati" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogTitle} />

    <!-- ─── Twitter / X Card ─────────────────────────────────────────────── -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogTitle} />

    <!-- ─── Favicon & Theme ───────────────────────────────────────────────── -->
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/x-icon" href="/favicon_ims_03.ico" />
    <link rel="apple-touch-icon" href="/ims-touch-icon.png" />
    <meta name="theme-color" content="#0f172a" />

    <!-- ─── Structured Data (JSON-LD) ─────────────────────────────────────── -->
    <JsonLd data={jsonLdData} />

    <!-- Langkah 1: Inisialisasi dataLayer sebelum gtag.js load -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      // Inisialisasi waktu hanya sekali (bukan tiap navigasi View Transitions)
      if (!window._gtagInitialized) {
        window._gtagInitialized = true;
        gtag("js", new Date());
        gtag("config", "G-G8R54H54VV", {
          send_page_view: false,
        });
      }
    </script>

    <!-- Langkah 2: Load library GA secara async (non-blocking) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-G8R54H54VV"></script>

    <!-- Langkah 3: Track pageview setiap navigasi (termasuk View Transitions) -->
    <script is:inline data-astro-rerun>
      document.addEventListener("astro:page-load", () => {
        if (typeof gtag === "function") {
          gtag("event", "page_view", {
            page_location: window.location.href,
            page_path: window.location.pathname,
          });
        }
      });
    </script>
    <!-- ─── End Google Analytics ──────────────────────────────────────────── -->

    <ClientRouter />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
  </head>
  <body class="bg-zinc-50 min-h-screen scroll-smooth">
    <PageLoader />

    <div id="scroll-progress"></div>

    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      import { initUI } from "../assets/tools/initflowbite";

      document.addEventListener("DOMContentLoaded", initUI);
      document.addEventListener("astro:after-swap", initUI);
    </script>

    <!-- Scroll progress logic — pakai is:inline agar jalan setelah View Transitions -->
    <script is:inline>
      function initScrollProgress() {
        const bar = document.getElementById("scroll-progress");
        if (!bar) return;

        function updateProgress() {
          const scrolled = window.scrollY;
          const total =
            document.documentElement.scrollHeight - window.innerHeight;
          bar.style.width = total > 0 ? (scrolled / total) * 100 + "%" : "0%";
        }

        // Reset ke 0 saat halaman baru dimuat
        bar.style.width = "0%";

        window.addEventListener("scroll", updateProgress, { passive: true });
        updateProgress();
      }

      // Load pertama
      document.addEventListener("DOMContentLoaded", initScrollProgress);

      // Setelah navigasi View Transitions
      document.addEventListener("astro:page-load", initScrollProgress);
    </script>
  </body>
</html>

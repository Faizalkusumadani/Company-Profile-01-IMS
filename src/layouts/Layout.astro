---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import PageLoader from "../components/Pageloader.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { pwaInfo } from "virtual:pwa-info";
import JsonLd from "../components/JsonLd.astro";
import { organizationSchema } from "../assets/tools/schema";
import CookieConsent from "../components/Cookie.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  url?: string;
  schema?: Record<string, any> | Record<string, any>[];
}

const SITE_URL = "https://intisukses-ms.com";
const {
  title,
  description,
  image = `${SITE_URL}/og-default.png`,
  url = Astro.url.href,
  schema,
} = Astro.props;

const lang = (Astro.params.lang as string) || "id";
const ogImage = image.startsWith("http") ? image : `${SITE_URL}${image}`;
const ogTitle = `Intisukses Mitra Sejati | ${title}`;

const jsonLdData = schema
  ? [organizationSchema, ...(Array.isArray(schema) ? schema : [schema])]
  : organizationSchema;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Intisukses Mitra Sejati | {title}</title>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Intisukses Mitra Sejati" />
    <meta name="robots" content="index, follow" />

    <!-- ─── Open Graph ────────────────────────────────────────────────────── -->
    <meta property="og:site_name" content="Intisukses Mitra Sejati" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "id" ? "id_ID" : "en_US"} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogTitle} />

    <!-- ─── Twitter / X Card ─────────────────────────────────────────────── -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogTitle} />

    <!-- ─── Favicon & Theme ───────────────────────────────────────────────── -->
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/x-icon" href="/favicon_ims_03.ico" />
    <link rel="apple-touch-icon" href="/ims-touch-icon.png" />
    <meta name="theme-color" content="#0f172a" />

    <!-- ─── Structured Data (JSON-LD) ─────────────────────────────────────── -->
    <JsonLd data={jsonLdData} />

    <!-- Langkah 1: Inisialisasi dataLayer & Consent Default -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        analytics_storage: "denied",
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        wait_for_update: 500,
      });

      // Jika user sudah pernah memberi consent dan belum kedaluwarsa, langsung update
      (function () {
        try {
          const raw = localStorage.getItem("cookie_consent");
          if (!raw) return;

          const saved = JSON.parse(raw);
          const CONSENT_VERSION = 1;
          const CONSENT_MAX_AGE_DAYS = 180;

          const isExpired =
            !saved.timestamp ||
            Date.now() - saved.timestamp >
              CONSENT_MAX_AGE_DAYS * 24 * 60 * 60 * 1000;

          if (isExpired || saved.version !== CONSENT_VERSION) return;

          gtag("consent", "update", {
            analytics_storage:
              saved.analytics === "granted" ? "granted" : "denied",
            ad_storage: saved.marketing === "granted" ? "granted" : "denied",
            ad_user_data: saved.marketing === "granted" ? "granted" : "denied",
            ad_personalization:
              saved.marketing === "granted" ? "granted" : "denied",
          });
        } catch (e) {
          // Data localStorage rusak/tidak valid, abaikan dan biarkan default denied
        }
      })();

      if (!window._gtagInitialized) {
        window._gtagInitialized = true;
        gtag("js", new Date());
        gtag("config", "G-G8R54H54VV", {
          send_page_view: false,
        });
      }
    </script>

    <!-- Langkah 2: Load library GA -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-G8R54H54VV"></script>

    <!-- Langkah 3: Track pageview (dipasang 1x, aman untuk View Transitions) -->
    <script is:inline>
      if (!window._gtagPageviewInit) {
        window._gtagPageviewInit = true;
        document.addEventListener("astro:page-load", () => {
          if (typeof window.gtag === "function") {
            window.gtag("event", "page_view", {
              page_location: window.location.href,
              page_path: window.location.pathname,
            });
          }
        });
      }
    </script>

    <!-- Client Router untuk View Transitions -->
    <ClientRouter />

    {
      pwaInfo && pwaInfo.webManifest && (
        <Fragment set:html={pwaInfo.webManifest.linkTag} />
      )
    }
  </head>
  <body class="bg-zinc-50 scroll-smooth">
    <PageLoader />
    <div id="scroll-progress"></div>

    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Komponen Cookie Consent -->
    <CookieConsent />

    <script>
      import { initUI } from "../assets/tools/initflowbite";

      document.addEventListener("DOMContentLoaded", initUI);
      document.addEventListener("astro:after-swap", initUI);
    </script>

    <!-- Scroll progress logic (Anti-Memory Leak) -->
    <script is:inline>
      (function () {
        function updateProgress() {
          const bar = document.getElementById("scroll-progress");
          if (!bar) return;

          const scrolled = window.scrollY;
          const total =
            document.documentElement.scrollHeight - window.innerHeight;
          bar.style.width = total > 0 ? (scrolled / total) * 100 + "%" : "0%";
        }

        if (!window._scrollProgressInit) {
          window._scrollProgressInit = true;
          window.addEventListener("scroll", updateProgress, { passive: true });
        }

        document.addEventListener("astro:page-load", updateProgress);
      })();
    </script>
  </body>
</html>

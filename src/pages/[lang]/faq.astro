---
import { languages } from "../../i18n/ui";

export async function getStaticPaths() {
  return Object.keys(languages).map((l) => ({
    params: { lang: l },
  }));
}

const { lang } = Astro.params;
const targetUrl = `/${lang}/maintenance`;
---

<div
  class="flex items-center justify-center min-h-screen bg-[#161616] text-white"
>
  <p class="text-sm text-gray-400">
    Mengalihkan ke halaman maintenance... Jika tidak berpindah,
    <a href={targetUrl} class="text-blue-400 underline">klik di sini</a>.
  </p>
</div>

<script define:vars={{ targetUrl }}>
  window.location.replace(targetUrl);
</script>

---
import Layout from "../../layouts/BasicLayout.astro";
import Banner from "../../components/Banner.astro";
import { languages } from "../../i18n/ui";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

export async function getStaticPaths() {
  return Object.keys(languages).map((l) => ({
    params: { lang: l },
  }));
}
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const breadcrumbs = [
  { label: t("home"), href: `/${lang}/`, key: "home" },
  { label: t("faq_label"), current: true, key: "faq_label" },
];

const title = t("faq_label"),
  description = t("faqdescription");
---

<Layout title={title} description={description}>
  <!-- Banner Section -->
  <Banner title={{ key: "faq_label" }} breadcrumbs={breadcrumbs} />
  <section id="FAQ">
    <div class="w-full px-4 py-13 sm:py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <div class="space-y-6 py-6 text-center"></div>
      </div>
    </div>
  </section></Layout
>

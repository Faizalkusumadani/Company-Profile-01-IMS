---
import Layout from "../../layouts/Layout.astro";
import Banner from "../../components/Banner.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Costumerservice from "../../assets/CS-IMS-0001.png";
import { languages } from "../../i18n/ui";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

export async function getStaticPaths() {
  return Object.keys(languages).map((l) => ({
    params: { lang: l },
  }));
}
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const breadcrumbs = [
  { label: t("home"), href: `/${lang}/`, key: "home" },
  { label: t("contact"), current: true, key: "contact" },
];

const title = t("contact"),
  description = t("contactdescription");

const zodMessages = {
  name: {
    min: t("zod.name.min"),
    max: t("zod.name.max"),
  },
  email: {
    invalid: t("zod.email.invalid"),
  },
  phone: {
    format: t("zod.phone.format"),
  },
  address: {
    min: t("zod.addres.min"),
    max: t("zod.addres.max"),
  },
  message: {
    min: t("zod.message.min"),
    max: t("zod.message.max"),
  },
};
---

<Layout title={title} description={description}>
  <!-- ===================== MODAL NOTIFIKASI ===================== -->
  <div
    id="modal-notify"
    class="hidden fixed inset-0 bg-slate-900/70 z-300 items-center justify-center p-4 backdrop-blur-md"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-notify-title"
  >
    <div
      class="bg-white rounded-3xl w-full max-w-md shadow-2xl border border-slate-100 overflow-hidden"
      style="animation: modalIn 0.3s cubic-bezier(0.34,1.56,0.64,1) both;"
    >
      <!-- Top accent bar -->
      <div
        id="modal-accent-bar"
        class="h-1.5 w-full bg-linear-to-r from-ims-red to-red-400"
      >
      </div>
      <div class="p-8 text-center">
        <!-- Icon sukses -->
        <div
          id="notify-icon-success"
          class="hidden w-20 h-20 rounded-full bg-green-50 items-center justify-center mx-auto mb-5 ring-8 ring-green-50"
        >
          <Icon name="local:succes" class="w-12 h-12 text-green-500" />
        </div>
        <!-- Icon error -->
        <div
          id="notify-icon-error"
          class="hidden w-20 h-20 rounded-full bg-red-50 items-center justify-center mx-auto mb-5 ring-8 ring-red-50"
        >
          <Icon name="local:warning" class="w-12 h-12 text-ims-red" />
        </div>

        <h3
          id="modal-notify-title"
          class="text-lg font-bold text-slate-800 mb-2"
        >
        </h3>
        <p
          id="modal-notify-message"
          class="text-sm text-slate-500 leading-relaxed mb-7"
        >
        </p>

        <button
          id="modal-notify-ok"
          type="button"
          class="px-10 py-2.5 bg-ims-red text-white font-semibold rounded-2xl hover:bg-red-700 shadow-lg shadow-red-200/60 transition-all text-sm focus:outline-none focus:ring-4 focus:ring-red-200"
        >
          OK
        </button>
      </div>
    </div>
  </div>
  <!-- ===================== END MODAL ===================== -->

  <!-- Banner Section -->
  <Banner title={{ key: "contact" }} breadcrumbs={breadcrumbs} />

  <!-- ===================== KONTAK SECTION ===================== -->
  <section id="kontak" class="relative overflow-hidden">
    <div class="w-full px-4 pt-20 pb-10">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-center">
          <!-- Text & Cards -->
          <div class="lg:col-span-3 space-y-8">
            <div>
              <span
                class="inline-flex items-center gap-2 text-xs font-bold tracking-[0.2em] text-ims-red uppercase mb-3"
              >
                <span class="w-5 h-px bg-ims-red inline-block"></span>
                {t("contactoffice") ?? "Hubungi Kami"}
              </span>
              <h2
                class="text-4xl sm:text-5xl font-extrabold text-slate-800 leading-tight tracking-tight"
              >
                {t("headercontact")}
              </h2>
              <div class="mt-4 flex gap-1.5">
                <div class="h-1 w-10 bg-ims-red rounded-full"></div>
                <div class="h-1 w-4 bg-red-200 rounded-full"></div>
                <div class="h-1 w-2 bg-red-100 rounded-full"></div>
              </div>
            </div>

            {
              (() => {
                type CardItem =
                  | {
                      icon: string;
                      title: string;
                      content: string;
                      download?: never;
                    }
                  | {
                      icon: string;
                      title: string;
                      content: string;
                      download: {
                        href: string;
                        filename: string;
                        label: string;
                      };
                    };

                const cards: CardItem[] = [
                  {
                    icon: "local:building",
                    title: t("contactoffice"),
                    content:
                      "Business Park Kebon Jeruk Blok C2 No. 8\nJl. Meruya Ilir Raya No. 88\nMeruya Utara, Kembangan\nJakarta 11620",
                  },
                  {
                    icon: "local:phone",
                    title: t("contactphone"),
                    content: "+62 21 300 678 68",
                  },
                  {
                    icon: "local:mail",
                    title: "E-mail",
                    content: "sales@intisukses-ms.com",
                  },
                  {
                    icon: "local:document",
                    title: t("about_profile"),
                    content: t("contactdescdownload"),
                    download: {
                      href: "/Document/Company Profile IMS.pdf",
                      filename: "Company-Profile-IMS.pdf",
                      label: t("contactdownload"),
                    },
                  },
                ];

                return (
                  <div class="grid sm:grid-cols-2 gap-4">
                    {cards.map((item) => (
                      <div class="group relative border border-gray-200 rounded-2xl p-5 hover:border-red-600/40 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 cursor-pointer">
                        <div class="relative z-10">
                          <div class="flex items-center gap-3 mb-3">
                            <div class="w-12 h-12 border border-gray-200 flex items-center justify-center group-hover:bg-ims-red group-hover:border-ims-red transition-all duration-300 rounded-xl">
                              <Icon
                                name={item.icon}
                                class="w-6 h-6 text-ims-red group-hover:text-white transition-colors duration-300"
                              />
                            </div>
                            <h3 class="font-bold text-slate-700 text-sm">
                              {item.title}
                            </h3>
                          </div>
                          <p class="text-sm text-slate-500 leading-relaxed whitespace-pre-line mb-3">
                            {item.content}
                          </p>
                          {item.download && (
                            <a
                              href={item.download.href}
                              download={item.download.filename}
                              class="inline-flex items-center gap-2 bg-ims-red hover:bg-red-700 text-white text-xs font-semibold px-4 py-2 rounded-xl transition-all duration-200 shadow-md shadow-red-200/60 hover:shadow-lg hover:shadow-red-300/50 hover:-translate-y-0.5"
                            >
                              <Icon
                                name="local:download"
                                class="w-4 h-4 shrink-0"
                              />
                              {item.download.label}
                            </a>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                );
              })()
            }
          </div>

          <!-- Image -->
          <div class="lg:col-span-2 flex justify-center lg:justify-end">
            <div class="relative">
              <div
                class="absolute -inset-6 rounded-full bg-linear-to-br from-red-100/40 to-slate-100/40 blur-2xl -z-10"
              >
              </div>
              <Image
                src={Costumerservice}
                width={480}
                height={480}
                decoding="async"
                loading="lazy"
                alt="Customer Service IMS"
                class="w-full max-w-sm object-contain drop-shadow-2xl"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- ── Divider ─────────────────────────────── -->
      <div class="max-w-6xl mx-auto px-4 mt-16">
        <div class="flex items-center gap-4">
          <div
            class="flex-1 h-px bg-linear-to-r from-transparent via-gray-200 to-transparent"
          >
          </div>
          <div class="flex gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-red-600/40"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-red-600/70"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-red-600/40"></span>
          </div>
          <div
            class="flex-1 h-px bg-linear-to-r from-transparent via-gray-200 to-transparent"
          >
          </div>
        </div>
      </div>

      <!-- ── Form Section ────────────────────────── -->
      <div class="max-w-6xl mx-auto">
        <div class="py-16 space-y-8">
          <!-- Form Header -->
          <div class="mb-10">
            <h2
              class="text-gray-700 text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight"
            >
              {t("contactform_1")}
              <span class="text-ims-red"> {t("contactform_2")}</span>
            </h2>
            <p class="text-gray-400 text-base mt-3 max-w-lg leading-relaxed">
              {t("contactformdescription")}
            </p>
          </div>

          <!-- Form Card -->
          <div
            id="zod-messages"
            class="py-8"
            data-zod={JSON.stringify(zodMessages)}
          >
            <form
              id="contact-form"
              name="website-message"
              novalidate
              class="space-y-2"
              data-loading-text={t("form.loading") ?? "Mengirim..."}
              data-success-title={t("form.success.title") ?? "Pesan Terkirim!"}
              data-success-msg={t("form.success.message") ??
                "Terima kasih telah menghubungi kami. Tim kami akan segera merespons pesan Anda."}
              data-error-title={t("form.error.title") ?? "Gagal Mengirim"}
              data-error-msg={t("form.error.message") ??
                "Terjadi kesalahan pada server. Silakan coba beberapa saat lagi."}
              data-network-title={t("form.network.title") ??
                "Koneksi Bermasalah"}
              data-network-msg={t("form.network.message") ??
                "Tidak dapat terhubung ke server. Periksa koneksi internet Anda dan coba lagi."}
            >
              <!-- Honeypot anti-spam: disembunyikan via CSS, bot akan isi ini -->
              <div
                aria-hidden="true"
                style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;"
              >
                <label for="_hp_name">Jangan isi field ini</label>
                <input
                  type="text"
                  id="_hp_name"
                  name="_honeypot"
                  tabindex="-1"
                  autocomplete="off"
                />
              </div>
              <div class="grid md:grid-cols-2 gap-x-10 gap-y-0">
                <!-- Name -->
                <div class="relative z-0 w-full mb-6 group">
                  <input
                    type="text"
                    name="name"
                    id="floating_first_name"
                    autocomplete="name"
                    class="block py-2.5 px-0 w-full text-sm text-gray-700 bg-transparent border-0 border-b-2 border-gray-200 appearance-none focus:outline-none focus:ring-0 focus:border-ims-red peer transition-colors duration-200"
                    placeholder=" "
                  />
                  <label
                    for="floating_first_name"
                    class="peer-focus:font-medium absolute text-sm text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-left peer-focus:inset-s-0 rtl:peer-focus:translate-x-1/4 peer-focus:text-ims-red peer-focus:dark:text-red-500 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6"
                    >{t("contactformname")}*</label
                  >
                  <p
                    id="error-name"
                    class="hidden mt-1.5 text-xs text-red-500 items-center gap-1"
                    aria-live="polite"
                  >
                    <svg
                      class="w-3 h-3 shrink-0"
                      viewBox="0 0 16 16"
                      fill="currentColor"
                      ><path
                        d="M8 1a7 7 0 100 14A7 7 0 008 1zm-.75 3.75a.75.75 0 011.5 0v3.5a.75.75 0 01-1.5 0v-3.5zm.75 7a.875.875 0 110-1.75.875.875 0 010 1.75z"
                      ></path></svg
                    >
                    <span></span>
                  </p>
                </div>

                <!-- Email -->
                <div class="relative z-0 w-full mb-6 group">
                  <input
                    type="email"
                    name="email"
                    id="floating_email"
                    autocomplete="email"
                    class="block py-2.5 px-0 w-full text-sm text-gray-700 bg-transparent border-0 border-b-2 border-gray-200 appearance-none focus:outline-none focus:ring-0 focus:border-ims-red peer transition-colors duration-200"
                    placeholder=" "
                  />
                  <label
                    for="floating_email"
                    class="peer-focus:font-medium absolute text-sm text-gray-500 duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-left peer-focus:text-ims-red peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6"
                    >{t("contactformmail")}*</label
                  >
                  <p
                    id="error-email"
                    class="hidden mt-1.5 text-xs text-red-500 items-center gap-1"
                    aria-live="polite"
                  >
                    <svg
                      class="w-3 h-3 shrink-0"
                      viewBox="0 0 16 16"
                      fill="currentColor"
                      ><path
                        d="M8 1a7 7 0 100 14A7 7 0 008 1zm-.75 3.75a.75.75 0 011.5 0v3.5a.75.75 0 01-1.5 0v-3.5zm.75 7a.875.875 0 110-1.75.875.875 0 010 1.75z"
                      ></path></svg
                    >
                    <span></span>
                  </p>
                </div>
              </div>

              <div class="grid md:grid-cols-2 md:gap-8">
                <!-- Phone -->
                <div class="relative z-0 w-full mb-6 group">
                  <input
                    type="tel"
                    name="phone"
                    id="floating_phone"
                    autocomplete="tel"
                    class="block py-2.5 px-0 w-full text-sm text-gray-700 bg-transparent border-0 border-b-2 border-gray-200 appearance-none focus:outline-none focus:ring-0 focus:border-ims-red peer transition-colors duration-200"
                    placeholder=" "
                  />
                  <label
                    for="floating_phone"
                    class="peer-focus:font-medium absolute text-sm text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-left peer-focus:inset-s-0 rtl:peer-focus:translate-x-1/4 peer-focus:text-ims-red peer-focus:dark:text-red-500 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6"
                    >{t("contactformphone")}* (Ex.0812-1234-1244)</label
                  >
                  <p
                    id="error-phone"
                    class="hidden mt-1.5 text-xs text-red-500 items-center gap-1"
                    aria-live="polite"
                  >
                    <svg
                      class="w-3 h-3 shrink-0"
                      viewBox="0 0 16 16"
                      fill="currentColor"
                      ><path
                        d="M8 1a7 7 0 100 14A7 7 0 008 1zm-.75 3.75a.75.75 0 011.5 0v3.5a.75.75 0 01-1.5 0v-3.5zm.75 7a.875.875 0 110-1.75.875.875 0 010 1.75z"
                      ></path></svg
                    >
                    <span></span>
                  </p>
                </div>

                <!-- Address -->
                <div class="relative z-0 w-full mb-6 group">
                  <input
                    type="text"
                    name="address"
                    id="floating_address"
                    autocomplete="street-address"
                    class="block py-2.5 px-0 w-full text-sm text-gray-700 bg-transparent border-0 border-b-2 border-gray-200 appearance-none focus:outline-none focus:ring-0 focus:border-ims-red peer transition-colors duration-200"
                    placeholder=" "
                  />
                  <label
                    for="floating_address"
                    class="peer-focus:font-medium absolute text-sm text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-left peer-focus:inset-s-0 rtl:peer-focus:translate-x-1/4 peer-focus:text-ims-red peer-focus:dark:text-red-500 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6"
                    >{t("contactformaddress")}*</label
                  >
                  <p
                    id="error-address"
                    class="hidden mt-1.5 text-xs text-red-500 items-center gap-1"
                    aria-live="polite"
                  >
                    <svg
                      class="w-3 h-3 shrink-0"
                      viewBox="0 0 16 16"
                      fill="currentColor"
                      ><path
                        d="M8 1a7 7 0 100 14A7 7 0 008 1zm-.75 3.75a.75.75 0 011.5 0v3.5a.75.75 0 01-1.5 0v-3.5zm.75 7a.875.875 0 110-1.75.875.875 0 010 1.75z"
                      ></path></svg
                    >
                    <span></span>
                  </p>
                </div>
              </div>

              <!-- Message -->
              <div class="mb-6">
                <label
                  for="message"
                  class="block mb-2 text-sm font-normal text-gray-500"
                >
                  {t("contactformmessage")}*
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  class="block p-4 w-full text-sm text-gray-700 bg-gray-50/80 rounded-2xl border border-gray-200 focus:ring-2 focus:ring-red-600/40 focus:border-ims-red placeholder-gray-300 resize-none transition-all duration-200 outline-none"
                  placeholder={`${t("contactformmessage")}...`}></textarea>
                <p
                  id="error-message"
                  class="hidden mt-1.5 text-xs text-red-500 items-center gap-1"
                  aria-live="polite"
                >
                  <svg
                    class="w-3 h-3 shrink-0"
                    viewBox="0 0 16 16"
                    fill="currentColor"
                    ><path
                      d="M8 1a7 7 0 100 14A7 7 0 008 1zm-.75 3.75a.75.75 0 011.5 0v3.5a.75.75 0 01-1.5 0v-3.5zm.75 7a.875.875 0 110-1.75.875.875 0 010 1.75z"
                    ></path></svg
                  >
                  <span></span>
                </p>
              </div>

              <!-- Submit -->
              <div class="text-end mt-4">
                <button
                  id="submit-btn"
                  type="submit"
                  class="inline-flex items-center justify-center border-2 border-ims-red text-ims-red px-6 sm:px-8 py-2 rounded-full font-normal hover:bg-red-700 hover:text-white transition-all duration-300 shadow-md hover:shadow-lg text-sm sm:text-base disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  <svg
                    id="loading-spinner"
                    class="hidden animate-spin -ml-1 mr-3 h-5 w-5 text-current"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                  >
                    <circle
                      class="opacity-25"
                      cx="12"
                      cy="12"
                      r="10"
                      stroke="currentColor"
                      stroke-width="4"></circle>
                    <path
                      class="opacity-75"
                      fill="currentColor"
                      d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                    ></path>
                  </svg>
                  <span id="btn-text">{t("ctaform")}</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <style>
      @keyframes modalIn {
        from {
          opacity: 0;
          transform: scale(0.9) translateY(10px);
        }
        to {
          opacity: 1;
          transform: scale(1) translateY(0);
        }
      }
    </style>

    <script>
      import { z } from "zod";

      // ── Ambil pesan Zod dari server (i18n) ────────
      function getZodMessages() {
        const el = document.getElementById("zod-messages");
        if (!el) return null;
        try {
          return JSON.parse(el.dataset.zod ?? "{}");
        } catch {
          return null;
        }
      }

      // ── Buat schema dengan pesan i18n ─────────────
      function buildSchema(msg: Record<string, Record<string, string>> | null) {
        // Fallback ke bahasa Indonesia jika i18n belum setup
        const m = msg ?? {};
        const n = m.name ?? {};
        const e = m.email ?? {};
        const p = m.phone ?? {};
        const a = m.address ?? {};
        const ms = m.message ?? {};

        return z.object({
          name: z
            .string()
            .min(2, n.min ?? "Nama minimal 2 karakter")
            .max(100, n.max ?? "Nama maksimal 100 karakter"),
          email: z.string().email(e.invalid ?? "Format email tidak valid"),
          phone: z
            .string()
            // Fix: regex lebih toleran — terima +62 atau 0, spasi, strip, 8–15 digit
            .regex(
              /^(\+62|0)[0-9\s\-]{7,15}$/,
              p.format ?? "Format nomor tidak valid (contoh: 0812-1234-1244)",
            ),
          address: z
            .string()
            .min(6, a.min ?? "Alamat minimal 6 karakter")
            .max(200, a.max ?? "Alamat maksimal 200 karakter"),
          message: z
            .string()
            .min(10, ms.min ?? "Pesan minimal 10 karakter")
            .max(1000, ms.max ?? "Pesan maksimal 1000 karakter"),
        });
      }

      // ── Tipe helper ───────────────────────────────
      type FormFields = z.infer<ReturnType<typeof buildSchema>>;

      // ── Konstanta ─────────────────────────────────
      const GOOGLE_SCRIPT_URL =
        "https://script.google.com/macros/s/AKfycbyT5IEOAeXXBM88vhwOBAKIbElKSOP5DUZHkkdhNMkPKH7B0hmMyRBiwMuh9KpR8Lcl/exec";

      const FIELD_NAMES = [
        "name",
        "email",
        "phone",
        "address",
        "message",
      ] as const;

      // ── Utility: tampilkan / sembunyikan modal ────
      function showModal(
        type: "success" | "error",
        title: string,
        message: string,
      ) {
        const modal = document.getElementById("modal-notify");
        const iconSuccess = document.getElementById("notify-icon-success");
        const iconError = document.getElementById("notify-icon-error");
        const modalTitle = document.getElementById("modal-notify-title");
        const modalMessage = document.getElementById("modal-notify-message");
        const accentBar = document.getElementById("modal-accent-bar");

        if (
          !modal ||
          !iconSuccess ||
          !iconError ||
          !modalTitle ||
          !modalMessage
        )
          return;

        iconSuccess.classList.add("hidden");
        iconSuccess.classList.remove("flex");
        iconError.classList.add("hidden");
        iconError.classList.remove("flex");

        if (type === "success") {
          iconSuccess.classList.remove("hidden");
          iconSuccess.classList.add("flex");
          accentBar?.classList.replace("from-ims-red", "from-green-400");
          accentBar?.classList.replace("to-red-400", "to-emerald-400");
        } else {
          iconError.classList.remove("hidden");
          iconError.classList.add("flex");
          accentBar?.classList.replace("from-green-400", "from-ims-red");
          accentBar?.classList.replace("to-emerald-400", "to-red-400");
        }

        modalTitle.textContent = title;
        modalMessage.textContent = message;
        modal.classList.remove("hidden");
        modal.classList.add("flex");
      }

      function hideModal() {
        const modal = document.getElementById("modal-notify");
        if (!modal) return;
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }

      // ── Utility: error field ──────────────────────
      function showFieldError(field: string, message: string) {
        const el = document.getElementById(`error-${field}`);
        const span = el?.querySelector("span");
        if (!el || !span) return;
        span.textContent = message;
        el.classList.remove("hidden");
        el.classList.add("flex");
      }

      function clearFieldError(field: string) {
        const el = document.getElementById(`error-${field}`);
        if (!el) return;
        const span = el.querySelector("span");
        if (span) span.textContent = "";
        el.classList.add("hidden");
        el.classList.remove("flex");
      }

      function clearAllErrors() {
        FIELD_NAMES.forEach(clearFieldError);
      }

      // ── Utility: loading state ────────────────────
      function setLoading(
        isLoading: boolean,
        loadingText: string,
        defaultText: string,
      ) {
        const submitBtn = document.getElementById(
          "submit-btn",
        ) as HTMLButtonElement | null;
        const btnText = document.getElementById("btn-text");
        const spinner = document.getElementById("loading-spinner");
        const sendIcon = document.getElementById("send-icon");

        if (!submitBtn || !btnText || !spinner) return;

        submitBtn.disabled = isLoading;
        spinner.classList.toggle("hidden", !isLoading);
        sendIcon?.classList.toggle("hidden", isLoading);
        btnText.textContent = isLoading ? loadingText : defaultText;
      }

      // ── Init setelah navigasi (Astro View Transitions) ──
      document.addEventListener("astro:page-load", () => {
        const form = document.getElementById(
          "contact-form",
        ) as HTMLFormElement | null;
        if (!form) return;

        // Ambil pesan i18n & bangun schema
        const zodMsg = getZodMessages();
        const contactSchema = buildSchema(zodMsg);

        // Teks loading dari data attribute (bisa juga dari i18n server jika perlu)
        const btnText =
          document.getElementById("btn-text")?.textContent ?? "Kirim pesan";
        const loadingText = form.dataset.loadingText ?? "Mengirim...";

        // Tutup modal
        document
          .getElementById("modal-notify-ok")
          ?.addEventListener("click", hideModal);
        document
          .getElementById("modal-notify")
          ?.addEventListener("click", (e) => {
            if (e.target === e.currentTarget) hideModal();
          });

        // Validasi inline per field (blur)
        FIELD_NAMES.forEach((field) => {
          const input = form.elements.namedItem(field) as
            | HTMLInputElement
            | HTMLTextAreaElement
            | null;
          input?.addEventListener("blur", () => {
            const partial = contactSchema.shape[field].safeParse(input.value);
            if (!partial.success) {
              showFieldError(
                field,
                partial.error.issues[0]?.message ?? "Input tidak valid",
              );
            } else {
              clearFieldError(field);
            }
          });
        });

        // Submit handler
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          clearAllErrors();

          // ── Honeypot check: jika terisi, kemungkinan bot ──
          const honeypot = (
            form.elements.namedItem("_honeypot") as HTMLInputElement | null
          )?.value;
          if (honeypot) {
            // Diam-diam tolak — jangan beri tahu bot bahwa mereka terdeteksi
            form.reset();
            showModal(
              "success",
              form.dataset.successTitle ?? "Pesan Terkirim!",
              form.dataset.successMsg ??
                "Terima kasih telah menghubungi kami. Tim kami akan segera merespons pesan Anda.",
            );
            return;
          }

          const formData = new FormData(form);
          const rawData = Object.fromEntries(formData.entries());
          const result = contactSchema.safeParse(rawData);

          if (!result.success) {
            const fieldErrors = result.error.flatten().fieldErrors;
            (Object.keys(fieldErrors) as Array<keyof FormFields>).forEach(
              (field) => {
                const messages = fieldErrors[field];
                if (messages?.length) showFieldError(field, messages[0]);
              },
            );
            return;
          }

          setLoading(true, loadingText, btnText);

          try {
            // ── Kirim sebagai URLSearchParams (application/x-www-form-urlencoded)
            // Ini cara yang benar untuk Google Apps Script karena:
            // 1. Menghindari CORS preflight yang diblokir Google Script
            // 2. Google Script menerima e.parameter dengan format ini
            // 3. FormData multipart kadang tidak di-parse benar oleh doPost()
            const params = new URLSearchParams();
            for (const [key, value] of formData.entries()) {
              if (key !== "_honeypot") {
                params.append(key, value.toString());
              }
            }

            const response = await fetch(GOOGLE_SCRIPT_URL, {
              method: "POST",
              // Tidak set Content-Type manual — biarkan browser set otomatis
              // agar sesuai dengan URLSearchParams
              headers: {
                "Content-Type": "application/x-www-form-urlencoded",
              },
              body: params.toString(),
              // Google Apps Script redirect ke URL baru setelah POST
              // "follow" memastikan kita ikut redirect tersebut
              redirect: "follow",
            });

            // Google Apps Script SELALU return HTTP 200 bahkan saat error.
            // Cek apakah response bisa di-parse sebagai JSON dengan field result.
            // Jika Google Script belum update → fallback: anggap sukses jika response.ok
            let isSuccess = false;

            const contentType = response.headers.get("content-type") ?? "";

            if (contentType.includes("application/json")) {
              // Google Script sudah dikonfigurasi return JSON
              try {
                const json = (await response.json()) as {
                  result?: string;
                  status?: string;
                };
                isSuccess =
                  json.result === "success" || json.status === "success";
              } catch {
                isSuccess = response.ok;
              }
            } else {
              // Google Script belum return JSON — fallback ke HTTP status
              // (response.ok = status 200-299, termasuk redirect yang sudah diikuti)
              isSuccess = response.ok;
            }

            if (isSuccess) {
              form.reset();
              clearAllErrors();
              showModal(
                "success",
                form.dataset.successTitle ?? "Pesan Terkirim!",
                form.dataset.successMsg ??
                  "Terima kasih telah menghubungi kami. Tim kami akan segera merespons pesan Anda.",
              );
            } else {
              showModal(
                "error",
                form.dataset.errorTitle ?? "Gagal Mengirim",
                form.dataset.errorMsg ??
                  "Terjadi kesalahan pada server. Silakan coba beberapa saat lagi.",
              );
            }
          } catch (error) {
            // Hanya tampilkan error di development
            if (import.meta.env.DEV) console.error("Submit error:", error);
            showModal(
              "error",
              form.dataset.networkTitle ?? "Koneksi Bermasalah",
              form.dataset.networkMsg ??
                "Tidak dapat terhubung ke server. Periksa koneksi internet Anda dan coba lagi.",
            );
          } finally {
            setLoading(false, loadingText, btnText);
          }
        });
      });
    </script>
  </section>
</Layout>

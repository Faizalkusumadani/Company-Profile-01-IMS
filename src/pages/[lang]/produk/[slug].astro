---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../../layouts/Layout.astro";
import Banner from "../../../components/Banner.astro";
import { Icon } from "astro-icon/components";
import { languages } from "../../../i18n/ui";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";
import Products from "../../../assets/tools/data";

// ─── TYPES ───────────────────────────────────────────────────────────────────

type Props = {
  product: CollectionEntry<"produk">;
};

type ProductData = CollectionEntry<"produk">["data"];
type ProductFeature = ProductData["features"][number];
type ProductVariant = ProductData["variants"][number];
type FeatureItem = ProductFeature["items"][number];

// ─── IMAGE GLOB (rekursif ke semua subfolder di src/assets/) ─────────────────

const allImageMap = import.meta.glob<{ default: ImageMetadata }>(
  "../../../assets/**/*.{png,jpg,jpeg,webp,svg}",
  { eager: true },
);

// ─── HELPER: RESOLVE IMAGE ────────────────────────────────────────────────────
function resolveImage(imagePath: string): ImageMetadata | null {
  if (!imagePath) return null;

  const normalized = imagePath.replace(/^\//, "").toLowerCase();

  const key = Object.keys(allImageMap).find((k) =>
    k.toLowerCase().endsWith(normalized),
  );

  return key ? allImageMap[key].default : null;
}

// ─── STATIC PATHS ─────────────────────────────────────────────────────────────
export async function getStaticPaths() {
  const allProduk = await getCollection("produk");

  // Ambil semua slug valid dari data.ts (sumber kebenaran untuk URL)
  const dataSlugSet = new Set(
    Products.map((p) => p.href.replace("/produk/", "")),
  );

  // Filter collection agar hanya yang ada di data.ts
  const filtered = allProduk.filter((p: CollectionEntry<"produk">) =>
    dataSlugSet.has(p.id.replace(/\.[^.]+$/, "")),
  );

  // Jika collection kosong, tidak ada halaman yang bisa dirender
  if (!filtered.length) return [];

  return Object.keys(languages).flatMap((lang) =>
    filtered.map((product: CollectionEntry<"produk">) => ({
      params: { lang, slug: product.id.replace(/\.[^.]+$/, "") },
      props: { product } satisfies Props,
    })),
  );
}

// ─── PAGE DATA ────────────────────────────────────────────────────────────────

const { product } = Astro.props as Props;
const { data } = product;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const title = t(data.nameKey as any);
const description = t(data.descKey as any);

// Resolve hero & logo — path dari .md langsung dipakai
const heroImage = resolveImage(data.image);
const logoImage = resolveImage(data.logo);

const breadcrumbs = [
  { label: t("home"), href: `/${lang}/`, key: "home" },
  { label: t("products"), href: `/${lang}/produk/`, key: "products" },
  { label: title, current: true, key: data.nameKey },
];
---

<Layout {title} {description}>
  <Banner title={{ key: data.nameKey }} breadcrumbs={breadcrumbs} />

  <!-- ─── HERO ─────────────────────────────────────────────────────────── -->
  <section id="product-hero">
    <div class="w-full px-4 py-15 md:py-10">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-8 md:gap-12 lg:grid-cols-2 items-center">
          <!-- Gambar Hero -->
          <div class="order-2 lg:order-1 rounded-2xl overflow-hidden">
            {
              heroImage ? (
                <Image
                  src={heroImage}
                  alt={title}
                  width={600}
                  height={600}
                  format="webp"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-auto object-cover"
                />
              ) : (
                <div class="w-full aspect-square bg-gray-100 flex items-center justify-center rounded-2xl">
                  <span class="text-gray-400 text-sm">
                    Gambar tidak tersedia
                  </span>
                </div>
              )
            }
          </div>

          <!-- Logo + Deskripsi -->
          <div class="order-1 lg:order-2 space-y-4 sm:space-y-6">
            {
              logoImage && (
                <div class="mb-6">
                  <Image
                    src={logoImage}
                    alt={`Logo ${title}`}
                    width={200}
                    height={80}
                    format="webp"
                    loading="lazy"
                    decoding="async"
                    class="w-auto h-20 object-contain"
                  />
                </div>
              )
            }
            <p
              class="text-base sm:text-base md:text-lg text-gray-600 leading-relaxed"
            >
              {description}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── TABS ──────────────────────────────────────────────────────────── -->
  <section id="tabs-content">
    <div class="w-full px-4 mb-10">
      <div class="mx-auto max-w-6xl">
        <!-- Tab Navigation -->
        <div class="mb-4 border-b border-gray-200 mt-10">
          <ul
            class="flex flex-wrap gap-0 md:gap-5 text-base font-normal text-gray-700"
            id="default-styled-tab"
            data-tabs-toggle="#default-styled-tab-content"
            data-tabs-active-classes="text-ims-red bg-gray-100 border-ims-red"
            data-tabs-inactive-classes="text-gray-500 border-gray-100 hover:border-gray-300"
            role="tablist"
          >
            <li role="presentation">
              <button
                class="inline-flex items-center p-4 border-b-2 rounded-t-lg"
                id="features-tab"
                data-tabs-target="#features"
                type="button"
                role="tab"
              >
                <Icon name="local:system" class="w-5 h-5 me-2 text-ims-red" />
                {t("specificationproducts")}
              </button>
            </li>
            <li role="presentation">
              <button
                class="inline-flex items-center p-4 border-b-2 rounded-t-lg"
                id="type-tab"
                data-tabs-target="#type"
                type="button"
                role="tab"
              >
                <Icon name="local:ac" class="w-5 h-5 me-2 text-ims-red" />
                {t("typeproducts")}
              </button>
            </li>
          </ul>
        </div>

        <!-- Tab Content -->
        <div id="default-styled-tab-content">
          <!-- Tab: Spesifikasi / Features -->
          <div class="hidden p-4" id="features" role="tabpanel">
            <h3 class="text-xl font-bold text-gray-900 py-5">
              {t("featuredspecification")}
            </h3>
            <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {
                data.features.map((feature: ProductFeature) => (
                  <li class="flex items-start space-x-3 p-3 rounded-lg hover:bg-blue-200 transition-colors">
                    <svg
                      class="shrink-0 w-6 h-6 text-ims-red mt-0.5"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    <div>
                      <h3 class="font-semibold text-gray-800">
                        {feature.titleKey
                          ? t(feature.titleKey as any)
                          : (feature as any).title}
                      </h3>
                      {feature.items?.length > 0 ? (
                        <ul class="space-y-1 text-gray-500 list-disc list-inside">
                          {feature.items.map((item: FeatureItem) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      ) : feature.descKey ? (
                        <p class="text-sm text-gray-600">
                          {t(feature.descKey as any)}
                        </p>
                      ) : null}
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Tab: Tipe / Variants -->
          <div class="hidden p-4" id="type" role="tabpanel">
            <h3 class="text-xl font-bold text-gray-900 py-5">
              {t("typeproducts")}
              {title} :
            </h3>
            <div
              class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 px-4"
            >
              {
                data.variants.map((variant: ProductVariant) => {
                  const variantImage = resolveImage(variant.image);
                  return (
                    <div class="group transform hover:-translate-y-2 transition-all duration-300">
                      <div class="relative h-48 sm:h-56 bg-linear-to-br from-blue-50 to-blue-100 rounded-2xl overflow-hidden">
                        {variantImage ? (
                          <Image
                            src={variantImage}
                            alt={variant.name}
                            width={350}
                            height={250}
                            format="webp"
                            loading="lazy"
                            decoding="async"
                            class="w-full h-full object-contain p-4 group-hover:scale-110 transition-transform duration-500"
                          />
                        ) : (
                          <div class="w-full h-full flex items-center justify-center">
                            <span class="text-gray-400 text-xs">
                              {variant.name}
                            </span>
                          </div>
                        )}
                      </div>
                      <p class="font-normal text-center text-gray-600 text-base mt-3 group-hover:text-ims-red transition-colors">
                        {variant.name}
                      </p>
                    </div>
                  );
                })
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

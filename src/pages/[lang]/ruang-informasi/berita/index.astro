---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../../../layouts/Layout.astro";
import Banner from "../../../../components/Banner.astro";
import { languages } from "../../../../i18n/ui";
import { getLangFromUrl, useTranslations } from "../../../../i18n/utils";

// ─── TYPES ────────────────────────────────────────────────────────────────────

type NewsEntry = CollectionEntry<"news">;

// ─── IMAGE GLOB ───────────────────────────────────────────────────────────────

const allImageMap = import.meta.glob<{ default: ImageMetadata }>(
  "../../../../assets/**/*.{png,jpg,JPG,JPEG,jpeg,webp,svg}",
  { eager: true },
);

// ─── HELPERS ─────────────────────────────────────────────────────────────────

function resolveImage(
  imagePath: string | null | undefined,
): ImageMetadata | null {
  if (!imagePath) return null;
  const normalized = imagePath.replace(/^\//, "").toLowerCase();
  const key = Object.keys(allImageMap).find((k) =>
    k.toLowerCase().endsWith(normalized),
  );
  return key ? allImageMap[key].default : null;
}

function formatDate(
  date: Date | string | null | undefined,
  lang: string,
): string {
  if (!date) return "";
  const d = date instanceof Date ? date : new Date(date);
  if (isNaN(d.getTime())) return String(date);
  return d.toLocaleDateString(lang === "id" ? "id-ID" : "en-US", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}

function toSlug(id: string): string {
  return id.replace(/\.[^.]+$/, "");
}

// ─── STATIC PATHS ─────────────────────────────────────────────────────────────

export async function getStaticPaths() {
  return Object.keys(languages).map((l) => ({
    params: { lang: l },
  }));
}

// ─── PAGE DATA ────────────────────────────────────────────────────────────────

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// ✅ Ambil dari collection "news" — harus cocok dengan config.ts
const allNews = await getCollection("news");

const newsList = [...allNews]
  .sort((a, b) => {
    const toMs = (d: Date | string | undefined) => {
      if (!d) return 0;
      const date = d instanceof Date ? d : new Date(d);
      return isNaN(date.getTime()) ? 0 : date.getTime();
    };
    const da = toMs(a.data.date);
    const db = toMs(b.data.date);
    if (da !== db) return db - da;
    return b.id.localeCompare(a.id);
  })
  .map((entry: NewsEntry) => {
    const slug = toSlug(entry.id);
    const cover = resolveImage(entry.data.cover);

    const title =
      (entry.data.titleKey ? t(entry.data.titleKey as any) : null) ||
      entry.data.title ||
      "Berita";

    const category =
      (entry.data.category ? t(entry.data.category as any) : null) ||
      entry.data.category ||
      "";

    const date =
      (entry.data.dateKey ? t(entry.data.dateKey as any) : null) ||
      formatDate(entry.data.date, lang);

    const excerpt =
      (entry.data.excerpKey ? t(entry.data.excerpKey as any) : null) ||
      entry.data.excerpt ||
      "";

    return {
      slug,
      title,
      date,
      // cover bisa null — ditangani di template dengan fallback placeholder
      image: cover,
      href: `/${lang}/ruang-informasi/berita/${slug}`,
      category,
      excerpt,
      isNew: entry.data.isNew ?? false,
    };
  });
// ✅ TIDAK filter berdasarkan image — berita tetap muncul walau cover belum ada

// ─── BREADCRUMBS ─────────────────────────────────────────────────────────────

const breadcrumbs = [
  { label: t("home"), href: `/${lang}/` },
  { label: t("info_room"), href: `/${lang}/` },
  { label: t("news"), current: true },
];

const pageTitle = t("news");
const pageDescription = t("newsdesc");
---

<Layout title={pageTitle} description={pageDescription}>
  <Banner title={{ key: "news" }} breadcrumbs={breadcrumbs} />

  <section id="berita">
    <div class="w-full px-4 sm:px-6 lg:px-8 py-12 sm:py-16 md:py-20 lg:py-24">
      <div class="mx-auto max-w-6xl">
        <div
          class="flex items-center justify-between mb-12 border-b border-gray-200 pb-4"
        >
          <h3 class="text-sm font-bold uppercase tracking-widest text-gray-400">
            {t("head_news")}
          </h3>
          <span class="text-xs text-gray-400">
            {newsList.length}
            {t("length_news")}
          </span>
        </div>

        {
          newsList.length === 0 ? (
            <div class="flex flex-col items-center justify-center py-16 sm:py-24 px-4 text-center">
              <div class="flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 mb-4 rounded-full bg-gray-50">
                <svg
                  class="w-8 h-8 sm:w-9 sm:h-9 text-gray-300"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  />
                </svg>
              </div>
              <p class="text-base sm:text-lg font-medium text-gray-500">
                Belum ada berita.
              </p>
            </div>
          ) : (
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 sm:gap-x-8 lg:gap-x-10 gap-y-10 sm:gap-y-12">
              {newsList.map((item) => (
                <a href={item.href} class="group block">
                  <div class="relative aspect-16/10 overflow-hidden rounded-xl bg-gray-100">
                    {item.image ? (
                      <Image
                        src={item.image}
                        alt={item.title}
                        width={350}
                        height={250}
                        densities={[1, 1.5, 2]}
                        decoding="async"
                        loading="lazy"
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center bg-gray-100">
                        <span class="text-gray-300 text-sm">Tanpa Gambar</span>
                      </div>
                    )}
                    {item.isNew && (
                      <span class="absolute top-3 left-3 bg-red-500 text-white text-xs font-bold px-2 py-1 rounded-md shadow-sm">
                        Baru
                      </span>
                    )}
                  </div>

                  <div class="mt-4 sm:mt-5">
                    <div class="flex items-center gap-1.5 text-gray-500 text-xs sm:text-sm">
                      <span>{item.date}</span>
                      {item.category && (
                        <>
                          <span aria-hidden="true">&middot;</span>
                          <span class="text-ims-red font-medium">
                            {item.category}
                          </span>
                        </>
                      )}
                    </div>
                    <h4 class="mt-1.5 sm:mt-2 text-gray-900 font-bold text-lg sm:text-xl leading-snug line-clamp-2 group-hover:text-ims-red transition-colors">
                      {item.title}
                    </h4>
                    {item.excerpt && (
                      <p class="mt-2 text-gray-500 text-sm leading-relaxed line-clamp-2">
                        {item.excerpt}
                      </p>
                    )}
                  </div>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </section>
</Layout>

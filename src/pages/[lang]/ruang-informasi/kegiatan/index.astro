---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../../../layouts/Layout.astro";
import Banner from "../../../../components/Banner.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { languages } from "../../../../i18n/ui";
import { getLangFromUrl, useTranslations } from "../../../../i18n/utils";

// ─── TYPES ────────────────────────────────────────────────────────────────────

type ActivityEntry = CollectionEntry<"activity">;

// ─── IMAGE GLOB ───────────────────────────────────────────────────────────────

const allImageMap = import.meta.glob<{ default: ImageMetadata }>(
  "../../../../assets/**/*.{png,jpg,JPG,JPEG,jpeg,webp,svg}",
  { eager: true },
);

// ─── HELPERS ─────────────────────────────────────────────────────────────────

/** Resolve path string dari frontmatter ke ImageMetadata */
function resolveImage(
  imagePath: string | null | undefined,
): ImageMetadata | null {
  if (!imagePath) return null;
  const normalized = imagePath.replace(/^\//, "").toLowerCase();
  const key = Object.keys(allImageMap).find((k) =>
    k.toLowerCase().endsWith(normalized),
  );
  return key ? allImageMap[key].default : null;
}

/** Format tanggal sesuai locale bahasa.
 *  Menerima Date object ATAU string ISO (mis. "2024-05-10") secara aman.
 */
function formatDate(
  date: Date | string | null | undefined,
  lang: string,
): string {
  if (!date) return "";
  const d = date instanceof Date ? date : new Date(date);
  if (isNaN(d.getTime())) return String(date);
  return d.toLocaleDateString(lang === "id" ? "id-ID" : "en-US", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}

/** Ambil slug bersih dari entry.id (buang ekstensi .md) */
function toSlug(id: string): string {
  return id.replace(/\.[^.]+$/, "");
}

// ─── STATIC PATHS ─────────────────────────────────────────────────────────────

export async function getStaticPaths() {
  return Object.keys(languages).map((l) => ({
    params: { lang: l },
  }));
}

// ─── PAGE DATA ────────────────────────────────────────────────────────────────

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allActivities = await getCollection("activity");

const activities = [...allActivities]
  // Sort aman: handle Date object dan string ISO
  .sort((a, b) => {
    const toMs = (d: Date | string | undefined) => {
      if (!d) return 0;
      const date = d instanceof Date ? d : new Date(d);
      return isNaN(date.getTime()) ? 0 : date.getTime();
    };
    const da = toMs(a.data.date);
    const db = toMs(b.data.date);
    if (da !== db) return db - da;
    return b.id.localeCompare(a.id); // fallback: nama file descending
  })
  .map((entry: ActivityEntry) => {
    const slug = toSlug(entry.id);
    const cover = resolveImage(entry.data.cover);

    // ── Judul: titleKey → i18n, fallback ke field title ──
    const title =
      t(entry.data.titleKey as any) || entry.data.title || "Kegiatan";

    // ── Kategori: bisa berupa i18n key atau teks langsung ──
    const category = t(entry.data.category as any) || entry.data.category || "";

    // ── Tanggal: dateKey → i18n (string teks), fallback ke date statis ──
    const date =
      (entry.data.dateKey ? t(entry.data.dateKey as any) : null) ||
      formatDate(entry.data.date, lang);

    // ── Excerpt: excerpKey → i18n (ambil paragraf pertama), fallback ke excerpt statis ──
    const excerpt =
      (entry.data.excerpKey ? t(entry.data.excerpKey as any) : null) ||
      entry.data.excerpt ||
      "";

    return {
      id: slug,
      title,
      date,
      image: cover,
      href: `/ruang-informasi/kegiatan/${slug}`,
      category,
      excerpt,
      isNew: entry.data.isNew ?? false,
    };
  })
  // Buang entry yang cover-nya tidak berhasil di-resolve
  .filter((a): a is typeof a & { image: ImageMetadata } => a.image !== null);

// Carousel: 5 item terbaru
const carouselItems = activities.slice(0, 5);

// Sidebar: hanya yang isNew === true
const sidebarItems = activities.filter((a) => a.isNew);

// ─── META ─────────────────────────────────────────────────────────────────────

const breadcrumbs = [
  { label: t("home"), href: `/${lang}/`, key: "home" },
  {
    label: t("info_room"),
    href: `/${lang}/`,
    key: "info_room",
  },
  { label: t("activities"), current: true, key: "activities" },
];

const title = t("activities");
const description = t("activitiesdesc");
---

<Layout {title} {description}>
  <Banner title={{ key: "activities" }} breadcrumbs={breadcrumbs} />

  <section id="Kegiatan">
    <div class="w-full px-4 sm:px-6 lg:px-8 py-12 sm:py-16 md:py-20 lg:py-24">
      <div class="max-w-6xl mx-auto">
        {
          activities.length === 0 ? (
            /* ── Empty State ── */
            <div class="flex flex-col items-center justify-center py-16 sm:py-24 px-4 text-center">
              <div class="flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 mb-4 rounded-full bg-gray-50">
                <svg
                  class="w-8 h-8 sm:w-9 sm:h-9 text-gray-300"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  />
                </svg>
              </div>
              <p class="text-base sm:text-lg font-medium text-gray-500">
                {t("activities")} belum tersedia.
              </p>
            </div>
          ) : (
            <>
              <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8">
                {/* ══ Carousel (kiri 2/3) ══ */}
                <div class="order-2 lg:order-1 lg:col-span-2">
                  <div
                    id="custom-controls-gallery"
                    class="relative w-full"
                    data-carousel="slide"
                  >
                    <div class="relative h-60 sm:h-80 md:h-102 overflow-hidden rounded-xl">
                      {carouselItems.map((activity, index) => (
                        <div
                          class="hidden duration-700 ease-in-out"
                          data-carousel-item={index === 0 ? "active" : ""}
                        >
                          <Image
                            src={activity.image}
                            alt={activity.title}
                            densities={[1, 1.5, 2]}
                            loading={index === 0 ? "eager" : "lazy"}
                            class="absolute block max-w-full h-full -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2 object-cover w-full"
                          />
                          <div class="absolute bottom-0 left-0 right-0 bg-linear-to-t from-black/85 via-black/45 to-transparent p-4 sm:p-6">
                            <div class="flex items-center gap-2 mb-2 sm:mb-3 flex-wrap">
                              <span class="inline-block bg-ims-red text-white text-[10px] sm:text-xs font-bold px-2.5 sm:px-3 py-1 rounded">
                                {activity.category}
                              </span>
                              {activity.isNew && (
                                <span class="inline-block bg-green-500 text-white text-[10px] sm:text-xs font-bold px-2.5 sm:px-3 py-1 rounded">
                                  Terbaru
                                </span>
                              )}
                            </div>
                            <a
                              href={`/${lang}${activity.href}`}
                              class="focus:outline-none"
                            >
                              <h2 class="text-white text-base sm:text-xl md:text-2xl font-semibold mb-1.5 sm:mb-2 leading-snug sm:leading-tight line-clamp-2 hover:underline">
                                {activity.title}
                              </h2>
                            </a>
                            {activity.excerpt && (
                              <p class="hidden sm:block text-gray-300 text-sm line-clamp-2">
                                {activity.excerpt}
                              </p>
                            )}
                          </div>
                        </div>
                      ))}

                      {/* Indicators */}
                      <div class="absolute z-30 flex -translate-x-1/2 bottom-3 left-1/2 space-x-1.5">
                        {carouselItems.map((_, index) => (
                          <button
                            type="button"
                            class="w-1.5 h-1.5 rounded-full bg-white/50 aria-current:bg-white transition-colors"
                            aria-current={index === 0 ? "true" : "false"}
                            aria-label={`Slide ${index + 1}`}
                            data-carousel-slide-to={index}
                          />
                        ))}
                      </div>
                    </div>

                    {/* Carousel Controls */}
                    <div class="flex justify-center items-center pt-4 sm:pt-5 gap-3">
                      <button
                        type="button"
                        class="flex justify-center items-center w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-gray-200 hover:border-ims-red hover:bg-red-50 cursor-pointer group transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-ims-red/40"
                        data-carousel-prev
                      >
                        <span class="text-gray-500 group-hover:text-ims-red">
                          <svg
                            class="rtl:rotate-180 w-5 h-5"
                            aria-hidden="true"
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            fill="none"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke="currentColor"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M5 12h14M5 12l4-4m-4 4 4 4"
                            />
                          </svg>
                          <span class="sr-only">Previous</span>
                        </span>
                      </button>
                      <button
                        type="button"
                        class="flex justify-center items-center w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-gray-200 hover:border-ims-red hover:bg-red-50 cursor-pointer group transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-ims-red/40"
                        data-carousel-next
                      >
                        <span class="text-gray-500 group-hover:text-ims-red">
                          <svg
                            class="rtl:rotate-180 w-5 h-5"
                            aria-hidden="true"
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            fill="none"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke="currentColor"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M19 12H5m14 0-4 4m4-4-4-4"
                            />
                          </svg>
                          <span class="sr-only">Next</span>
                        </span>
                      </button>
                    </div>
                  </div>
                </div>

                {/* ══ Sidebar: Kegiatan Terbaru  ══ */}
                <div class="order-1 lg:order-2 lg:col-span-1">
                  <div class="overflow-hidden rounded-xl border border-gray-200 ">
                    <div class="bg-linear-to-r from-red-600 to-red-700 px-5 sm:px-6 py-3.5 sm:py-4">
                      <h3 class="text-white text-base sm:text-lg font-semibold">
                        {t("activitiesdesc_new")}
                      </h3>
                    </div>
                    <div class="divide-y divide-gray-100">
                      {sidebarItems.length === 0 ? (
                        <p class="text-gray-400 text-sm p-5 text-center">
                          Belum ada kegiatan terbaru.
                        </p>
                      ) : (
                        sidebarItems.map((activity) => (
                          <a
                            href={`/${lang}${activity.href}`}
                            class="block p-4 hover:bg-gray-50 active:bg-gray-100 transition-colors cursor-pointer"
                          >
                            <article>
                              <div class="flex gap-3.5">
                                <Image
                                  src={activity.image}
                                  alt={activity.title}
                                  densities={[1, 1.5, 2]}
                                  loading="lazy"
                                  class="w-20 h-16 sm:w-24 sm:h-16 object-cover rounded-lg shrink-0"
                                />
                                <div class="flex-1 min-w-0">
                                  <div class="flex items-center gap-1.5 mb-1">
                                    <h4 class="text-gray-400 font-normal text-xs leading-snug line-clamp-1">
                                      {activity.category}
                                    </h4>
                                    {activity.isNew && (
                                      <span class="inline-block bg-green-100 text-green-700 text-xs font-semibold px-1.5 py-0.5 rounded shrink-0">
                                        Terbaru
                                      </span>
                                    )}
                                  </div>
                                  <div class="flex items-center text-gray-500 text-xs mb-1">
                                    <Icon
                                      name="local:calendar"
                                      class="w-3.5 h-3.5 mr-1.5 shrink-0"
                                    />
                                    <span>{activity.date}</span>
                                  </div>
                                  <span class="font-semibold text-sm text-gray-900 line-clamp-2 leading-snug block mb-1">
                                    {activity.title}
                                  </span>
                                </div>
                              </div>
                            </article>
                          </a>
                        ))
                      )}
                    </div>
                  </div>
                </div>
              </div>

              {/* ══ Grid Semua Kegiatan ══ */}
              <div class="py-10 sm:py-12">
                <div class="flex items-center justify-between mb-12 border-b border-gray-200 pb-4">
                  <h3 class="text-sm font-bold uppercase tracking-widest text-gray-400">
                    {t("head_activities")}
                  </h3>
                  <span class="text-xs text-gray-400">
                    {activities.length} {t("length_activities")}
                  </span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 sm:gap-x-8 lg:gap-x-10 gap-y-10 sm:gap-y-12">
                  {activities.map((activity, i) => (
                    <a href={`/${lang}${activity.href}`} class="group block">
                      <div class="relative aspect-16/10 overflow-hidden rounded-xl bg-gray-100">
                        <Image
                          src={activity.image}
                          alt={activity.title}
                          loading={i < 6 ? "eager" : "lazy"}
                          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                          transition:name={`activity-${activity.id}-image`}
                        />
                        {activity.isNew && (
                          <span class="absolute top-3 left-3 bg-green-500 text-white text-xs font-bold px-2 py-1 rounded-md shadow-sm">
                            Terbaru
                          </span>
                        )}
                      </div>
                      <div class="mt-4 sm:mt-5">
                        <div class="flex items-center gap-1.5 text-gray-500 text-xs sm:text-sm">
                          <span>{activity.date}</span>
                          {activity.category && (
                            <>
                              <span aria-hidden="true">&middot;</span>
                              <span class="text-ims-red font-medium">
                                {activity.category}
                              </span>
                            </>
                          )}
                        </div>
                        <h4 class="mt-1.5 sm:mt-2 text-gray-900 font-bold text-lg sm:text-xl leading-snug line-clamp-2 group-hover:text-ims-red transition-colors">
                          {activity.title}
                        </h4>
                        {activity.excerpt && (
                          <p class="mt-2 text-gray-500 text-sm leading-relaxed line-clamp-2">
                            {activity.excerpt}
                          </p>
                        )}
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </>
          )
        }
      </div>
    </div>
  </section>

  <script>
    import { initCarousels } from "flowbite";

    function initCarousel() {
      setTimeout(() => {
        initCarousels();
      }, 100);
    }

    document.addEventListener("DOMContentLoaded", initCarousel);
    document.addEventListener("astro:page-load", initCarousel);
  </script>
</Layout>

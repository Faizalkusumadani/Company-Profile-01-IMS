---
import Layout from "../../../layouts/Layout.astro";
import Banner from "../../../components/Banner.astro";
import R from "../../../assets/Founders/R.png";
import M from "../../../assets/Founders/M.png";
import FounderModal from "../../../components/Modal.astro";
import { Image } from "astro:assets";
import { languages } from "../../../i18n/ui";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

export async function getStaticPaths() {
  return Object.keys(languages).map((l) => ({
    params: { lang: l },
  }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const breadcrumbs = [
  { label: t("home"), href: `/${lang}/`, key: "home" },
  { label: t("about"), href: `/${lang}/`, key: "about" },
  { label: t("about_management"), current: true, key: "about_management" },
];

const title = t("about_management");
const description = t("aboutmanagementdescription");
---

<Layout title={title} description={description}>
  <!-- Banner Section -->
  <Banner title={{ key: "about_management" }} breadcrumbs={breadcrumbs} />

  <!-- Konten -->
  <section id="Pendiri">
    <div class="w-full px-4 sm:px-6 py-12 md:py-20">
      <div class="mx-auto max-w-6xl">
        <!-- Director 1: Rudy Gunawan -->
        <div class="mb-16 md:mb-20">
          <div class="flex flex-col md:grid md:grid-cols-3 gap-8 items-center">
            <!-- Foto -->
            <div class="flex justify-center w-full md:col-span-1">
              <div
                class="relative w-48 h-60 sm:w-56 sm:h-72 md:w-64 md:h-80 ring-4 ring-white bg-blue-100 rounded-2xl"
              >
                <Image
                  src={R}
                  width={400}
                  height={500}
                  class="w-full h-full rounded-2xl object-cover shadow-lg hover:shadow-xl transition-shadow duration-300"
                  alt="Rudy Gunawan"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>

            <!-- Teks -->
            <div
              class="md:col-span-2 space-y-4 md:space-y-6 text-center md:text-start"
            >
              <div>
                <h2 class="text-xl sm:text-2xl font-bold text-gray-900 mb-1">
                  Rudy Gunawan
                </h2>
                <p class="text-ims-red font-medium text-sm sm:text-base">
                  {t("founder_commissioner")}
                </p>
              </div>

              <p
                class="text-gray-500 text-sm sm:text-base md:text-lg leading-relaxed line-clamp-4"
              >
                {t("managementdescription_1")}
              </p>

              <div class="pt-1">
                <button
                  data-founder-id="profile-1"
                  type="button"
                  class="inline-flex items-center justify-center border border-ims-red text-ims-red px-4 py-2 rounded-2xl font-normal hover:bg-red-700 hover:text-white transition-all duration-300 shadow-md hover:shadow-lg text-sm sm:text-base"
                >
                  {t("ctaabout")}
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Divider -->
        <div class="h-px bg-gray-200 dark:bg-gray-700 my-12 md:my-16"></div>

        <!-- Director 2: Megawati Hamid -->
        <div>
          <div class="flex flex-col md:grid md:grid-cols-3 gap-8 items-center">
            <!-- Foto: kanan di desktop -->
            <div class="flex justify-center w-full md:col-span-1 md:order-2">
              <div
                class="relative w-48 h-60 sm:w-56 sm:h-72 md:w-64 md:h-80 ring-4 ring-white bg-blue-100 rounded-2xl"
              >
                <Image
                  src={M}
                  width={400}
                  height={500}
                  class="w-full h-full rounded-2xl object-cover object-top shadow-lg hover:shadow-xl transition-shadow duration-300"
                  alt="Megawati Hamid"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>

            <!-- Teks -->
            <div
              class="md:col-span-2 space-y-4 md:space-y-6 md:order-1 text-center md:text-start"
            >
              <div>
                <h2 class="text-xl sm:text-2xl font-bold text-gray-900 mb-1">
                  Megawati Hamid
                </h2>
                <p class="font-medium text-ims-red text-sm sm:text-base">
                  {t("founder_director")}
                </p>
              </div>

              <p
                class="text-gray-500 text-sm sm:text-base md:text-lg leading-relaxed line-clamp-4"
              >
                {t("managementdescription_2")}
              </p>

              <div class="pt-1">
                <button
                  data-founder-id="profile-2"
                  type="button"
                  class="inline-flex items-center justify-center border border-ims-red text-ims-red px-4 py-2 rounded-2xl font-normal hover:bg-red-700 hover:text-white transition-all duration-300 shadow-md hover:shadow-lg text-sm sm:text-base"
                >
                  {t("ctaabout")}
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ✅ Render FounderModal sekali di sini — tombol di atas otomatis terhubung -->
  <FounderModal />
</Layout>

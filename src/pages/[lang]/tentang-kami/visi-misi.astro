---
import Layout from "../../../layouts/Layout.astro";
import Banner from "../../../components/Banner.astro";
import { Icon } from "astro-icon/components";
import { languages } from "../../../i18n/ui";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

export async function getStaticPaths() {
  return Object.keys(languages).map((l) => ({
    params: { lang: l },
  }));
}
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const breadcrumbs = [
  { label: t("home"), href: `/${lang}/`, key: "home" },
  { label: t("about"), href: `/${lang}/`, key: "about" },
  { label: t("about_vision"), current: true, key: "about_vision" },
];

const title = t("about_vision"),
  description = t("aboutvisiondescription");
---

<Layout title={title} description={description}>
  <!-- Banner -->
  <Banner title={{ key: "about_vision" }} breadcrumbs={breadcrumbs} />

  <!-- Section: Visi & Misi -->
  <section id="visi-misi">
    <div class="w-full px-4 py-13 sm:py-16 md:py-20 lg:py-24">
      <div class="max-w-6xl mx-auto">
        <div class="grid md:grid-cols-2 gap-8 md:gap-16 items-start">
          <!-- Visi -->
          <div class="transition-shadow duration-300 rounded-2xl">
            <div class="flex items-center mb-5 space-x-4">
              <div
                class="bg-red-600/10 p-4 rounded-full text-ims-red hover:scale-110 transition-transform duration-300"
              >
                <Icon name="local:visi" class="w-15 h-15" />
              </div>
              <h3 class="text-3xl sm:text-4xl font-bold text-gray-900">
                {t("vision")}
              </h3>
            </div>

            <p class="text-gray-500 text-base md:text-lg leading-relaxed mb-4">
              {t("headervission")}
            </p>

            <ul class="space-y-4 text-left text-body">
              <li class="flex items-start space-x-3 rtl:space-x-reverse">
                <svg
                  class="w-6 h-6 text-ims-red shrink-0 me-2.5 mt-1"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  fill="none"
                  viewBox="0 0 24 24"
                  ><path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8.5 11.5 11 14l4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                  ></path></svg
                >
                <span class="text-gray-500 text-sm md:text-base"
                  >{t("arcticlevission")}</span
                >
              </li>
              <li class="flex items-start space-x-3 rtl:space-x-reverse">
                <svg
                  class="w-6 h-6 text-ims-red shrink-0 me-2.5 mt-1"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  fill="none"
                  viewBox="0 0 24 24"
                  ><path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8.5 11.5 11 14l4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                  ></path></svg
                >
                <span class="text-gray-500 text-sm md:text-base">
                  {t("arcticlevission_1")}</span
                >
              </li>
            </ul>
          </div>

          <!-- Misi -->
          <div class="transition-shadow duration-300 rounded-2xl">
            <div class="flex items-center mb-5 space-x-4">
              <div
                class="bg-red-600/10 p-4 rounded-full text-red-600/80 hover:scale-110 transition-transform duration-300"
              >
                <Icon name="local:target" class="w-15 h-15" />
              </div>
              <h3 class="text-3xl sm:text-4xl font-bold text-gray-900">
